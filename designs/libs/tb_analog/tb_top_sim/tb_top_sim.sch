C {devices/code_shown.sym} 1030 -150 0 0 {name=Models only_toplevel=false
format="tcleval( @value )"
value="
.include $::180MCU_MODELS/design.ngspice
.include /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/spice/gf180mcu_fd_sc_mcu9t5v0.spice
.lib $::180MCU_MODELS/sm141064.ngspice typical
.lib $::180MCU_MODELS/sm141064.ngspice cap_mim
.lib $::180MCU_MODELS/sm141064.ngspice mimcap_typical
.lib $::180MCU_MODELS/sm141064.ngspice res_typical
.lib $::180MCU_MODELS/sm141064.ngspice moscap_typical
.lib $::180MCU_MODELS/sm141064.ngspice bjt_typical
"}
C {devices/code_shown.sym} 1070 -1390 0 0 {name=NGSPICE only_toplevel=true
value="
.temp 27
.param Tbit = 20n
.ic v(osc_out)=0
.options savecurrents
.global VDDd VSSd
.control
save all
**Frequency & time settings
let fsig = 20k
let tper=1/fsig
let tfr = 0.5*tper
let ton = 0.5*tper-2*tfr

let tstop = 4 * tper
let tstep = 0.001*tper


**voltages
*alter @VINP[PULSE] = [ 0 3.0 1u $&tfr $&tfr $&ton $&tper 3 ]
alter @VINP[DC] = 2
alter @VINP[SIN] = [ 1.6 0.4 $&fsig 0 0 ]

**simulation
OP
*show all > op.log
show all

**Temperature analysis
tran 2n 200u 0
let t = $temp
print t

**voltage reference analysis
plot v8#branch

**oscillator & comparator analysis
*plot osc_out vsig Comp_out
plot Comp_out

**deadtime & driver analysis
*plot nmos pmos
*plot out

meas tran tfall_p WHEN v(pmos)=0.68 FALL=2
meas tran tfall_n WHEN v(nmos)=0.68 FALL=2

meas tran trise_p WHEN v(pmos)=0.68 RISE=2
meas tran trise_n WHEN v(nmos)=0.68 RISE=2

let delay_fall = $&tfall_p - $&tfall_n
let delay_rise = $&trise_p - $&trise_n

print delay_fall
print delay_rise

meas tran v_max MAX v(out)
meas tran v_min MIN v(out)
let vpp = $&v_max - $&v_min
print vpp

**check shoot-through analysis
plot @r5[i] v3#branch v4#branch 
*@m.xm1.m0[id]
*plot @m.xm1.m0[id]
plot v4#branch


write Full_Output_Stage_tb.txt
.endc
"}
